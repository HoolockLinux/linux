/ {
	aliases {
		serial0 = &serial0;
	};

	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		stdout-path = "serial0";

		framebuffer0: framebuffer@0 {
			compatible = "apple,simple-framebuffer", "simple-framebuffer";
			reg = <0 0 0 0>; /* To be filled by loader */
			power-domains = <&ps_disp0_fe &ps_disp0_be &ps_dp>;
			/* Format properties will be added by loader */
			status = "disabled";
		};
	};

	memory@800000000 {
		device_type = "memory";
		reg = <0x8 0 0 0>; /* To be filled by loader */
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		/* To be filled by loader */
	};
};

&i2c0 {
	status = "okay";

	d2400_pmic: pmic@3c {
		compatible = "dlg,da2400", "dlg,i2c-da2xxx";
		reg = <0x3c>;
		#address-cells = <1>;
		#size-cells = <0>;
	};

	d2401_pmic: pmic@40 {
		compatible = "dlg,da2401", "dlg,i2c-da2xxx";
		reg = <0x40>;
		#address-cells = <1>;
		#size-cells = <0>;
	};
};

&serial0 {
	status = "okay";
};
