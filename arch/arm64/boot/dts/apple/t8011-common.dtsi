/ {
	aliases {
		ausbphy0 = &ausbphy0; /* Used by loader */
		serial0 = &serial0;
	};

	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		stdout-path = "serial0";

		framebuffer0: framebuffer@0 {
			compatible = "apple,simple-framebuffer", "simple-framebuffer";
			reg = <0 0 0 0>; /* To be filled by loader */
			power-domains = <&ps_disp0_fe &ps_disp0_be &ps_dp>;
			/* Format properties will be added by loader */
			status = "disabled";
		};
	};

	memory@800000000 {
		device_type = "memory";
		reg = <0x8 0 0 0>; /* To be filled by loader */
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		/* To be filled by loader */
	};
};

&i2c0 {
	status = "okay";

	d2400_pmic: pmic@3c {
		compatible = "dlg,da2400", "dlg,i2c-da2xxx";
		reg = <0x3c>;
		#address-cells = <1>;
		#size-cells = <1>;

		rtc@500 {
			compatible = "dlg,da2400-rtc", "dlg,da2255-rtc";
			reg = <0x500 0x10>;
			nvmem-cells = <&rtc_offset>;
			nvmem-cell-names = "rtc_offset";
		};

		nvmem@5000 {
			compatible = "dlg,da2xxx-nvmem";
			reg = <0x5000 0x28>;

			nvmem-layout {
				compatible = "fixed-layout";
				#address-cells = <1>;
				#size-cells = <1>;

				rtc_offset: rtc-offset@4 {
					reg = <0x4 0x4>;
				};
			};
		};
	};

	d2401_pmic: pmic@40 {
		compatible = "dlg,da2401", "dlg,i2c-da2xxx";
		reg = <0x40>;
		#address-cells = <1>;
		#size-cells = <1>;
	};
};

&serial0 {
	status = "okay";
};
